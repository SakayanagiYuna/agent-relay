# Copy this file to .env and replace every placeholder with values for this machine.
# .env is local-only and is ignored by Git. Do not commit credentials.

AGENT_RELAY_WORKER_ID=replace-with-this-machine-worker-id
AGENT_RELAY_ALLOWED_USER_ID=replace-with-authorized-slack-user-id
AGENT_RELAY_CHATGPT_APP_ID=replace-with-chatgpt-slack-app-id
AGENT_RELAY_CHANNEL_ID=replace-with-slack-channel-id
# Repo allowlist lives in gitignored .agent-relay/projects.json.
# Copy projects.example.json there and replace placeholders. Do not put
# workspace IDs, repo IDs, or local paths in committed files.

SLACK_BOT_TOKEN=replace-with-slack-bot-token
SLACK_APP_TOKEN=replace-with-slack-app-token

# Optional: default is workspace-write. Allowed values: read-only, workspace-write.
CODEX_SANDBOX_MODE=workspace-write
# Optional: normal (default) shows concise Codex progress in this machine's
# terminal only. debug additionally prints redacted raw Codex JSONL events and
# Execution Heartbeat for local diagnosis. Slack never receives intermediate progress.
AGENT_RELAY_LOG_LEVEL=normal
# Optional: set true only on a Browser Worker machine. When enabled, every
# requested browser URL must use one of these exact loopback origins.
# AGENT_RELAY_BROWSER_EVIDENCE_ENABLED=true
# AGENT_RELAY_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:5173
# Optional: absolute path to the browser used by Relay Browser Runtime and
# Browser Evidence. When unset, Windows falls back to a standard Edge install.
# Windows Chrome example:
# AGENT_RELAY_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# AGENT_RELAY_BROWSER_EXECUTABLE_PATH=replace-with-local-browser-executable-path
# Optional: 1000-60000; default is 15000.
# AGENT_RELAY_BROWSER_EVIDENCE_TIMEOUT_MS=15000
# Optional: enables terminal-state wake-ups through an already running Browser
# Callback control server. It must be this explicit loopback endpoint.
# AGENT_RELAY_BROWSER_CALLBACK_URL=http://127.0.0.1:8787/api/callback
# Optional: explicit ARMED callback target ID returned by Browser Callback Bind.
# AGENT_RELAY_BROWSER_CALLBACK_TARGET_ID=target-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: terminal Human Notification. Disabled is the default. `email` uses
# a local Nodemailer SMTP transport. Keep the user and secret in this ignored file.
# AGENT_RELAY_NOTIFY_ENABLED=true
# AGENT_RELAY_NOTIFY_PROVIDER=email
# AGENT_RELAY_NOTIFY_EMAIL_TO=ops@example.com
# AGENT_RELAY_NOTIFY_SMTP_HOST=smtp.example.com
# AGENT_RELAY_NOTIFY_SMTP_PORT=587
# AGENT_RELAY_NOTIFY_SMTP_USER=relay@example.com
# AGENT_RELAY_NOTIFY_SMTP_SECRET=local-only-secret
# Optional: Relay-managed, isolated persistent browser profile. The default is
# <this-repository>/.agent-relay/chrome-profile; never point this at a daily-use browser profile.
# AGENT_RELAY_BROWSER_PROFILE_PATH=replace-with-absolute-relay-managed-profile-path
# Optional: initial page for the managed context. It must be an allowlisted ChatGPT URL.
# AGENT_RELAY_BROWSER_START_URL=https://chatgpt.com/
# Optional: set to false to make `npm run browser:init` exit without launching Chromium.
# AGENT_RELAY_BROWSER_RUNTIME_ENABLED=true
# Optional: loopback CDP port used only by the Relay-managed browser runtime.
# AGENT_RELAY_BROWSER_CDP_PORT=9333
# Optional: leave unset to use the native Codex executable discovery.
# CODEX_BIN=replace-with-absolute-path-to-codex-executable
# Optional: host default when a CODEX_TASK omits agent. Desktop Console 右栏
# 会读写这一项；打开 Console 时从本文件校准下拉框。合法值：codex 或 grok。
# AGENT_RELAY_DEFAULT_AGENT=codex
# Optional: used only by CODEX_TASK entries with agent: grok. When unset,
# Relay discovers grok on PATH at task execution time. Authenticate separately
# with `grok login` (or configure XAI_API_KEY in Grok's own local environment).
# AGENT_RELAY_GROK_BIN=replace-with-absolute-path-to-grok-executable
